# Payment mode is managed in admin Integrations / payment_settings; defaults demo.
# Generate once: 32 random bytes encoded as 64 hex characters. Preserve this key.
# INTEGRATION_ENCRYPTION_KEY=...
# Optional server fallback. Admin-saved credentials use authenticated encryption.
# Never expose these through VITE_* frontend variables.
# BAKONG_ACCOUNT_ID=your_receiver
# BAKONG_API_TOKEN=your_token
# MERCHANT_NAME=CamboBid
# MERCHANT_CITY=Phnom Penh

# Optional exact extra frontend origins, comma-separated (no wildcard).
# Local Supabase accepts its local development origins automatically.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
